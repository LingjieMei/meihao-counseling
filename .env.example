NODE_ENV=production
PORT=3000

# ── 数据库 ────────────────────────────────────────────────────────────────────
# MySQL 连接字符串，例如：
# mysql://user:password@host:3306/meihao_counseling
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# ── 会话安全 ──────────────────────────────────────────────────────────────────
# 用于签发 JWT Cookie 的密钥，部署前请替换为足够长的随机字符串
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# 应用 ID，部署后保持不变，否则已登录用户需要重新登录
VITE_APP_ID=meihao-counseling

# ── 文件存储（S3 兼容）────────────────────────────────────────────────────────
# 支持 AWS S3、阿里云 OSS、腾讯云 COS、Cloudflare R2、MinIO 等
# 阿里云 OSS 示例：
#   S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   S3_REGION=oss-cn-hangzhou
# Cloudflare R2 示例：
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY
S3_BUCKET_NAME=your-bucket-name
# 可选：配置后前端直接访问公开 URL，不走后端代理（推荐配置以提升性能）
# S3_PUBLIC_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# ── AI 督导功能（可选）────────────────────────────────────────────────────────
# 不填则 AI 督导功能不可用，其他功能正常运行
DEEPSEEK_API_KEY=

# ── 语音转写功能（可选）──────────────────────────────────────────────────────
# 使用 OpenAI Whisper API 进行语音转写，不填则语音功能不可用
# 如需使用 Groq 等兼容服务，同时设置 OPENAI_WHISPER_BASE_URL
OPENAI_API_KEY=
# OPENAI_WHISPER_BASE_URL=https://api.groq.com/openai/v1
